rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Tipos y tamaños permitidos (deben coincidir con APP_CONFIG.maxMB en index.html)
    function validUpload() {
      return (request.resource.contentType.matches('image/(jpeg|png|webp|gif)') && request.resource.size <= 25 * 1024 * 1024)
          || (request.resource.contentType.matches('video/(mp4|webm|quicktime)') && request.resource.size <= 200 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/(mpeg|wav|x-wav|ogg|mp4|x-m4a)') && request.resource.size <= 100 * 1024 * 1024);
    }

    match /files/{uid}/{fileName} {
      // Lectura vía SDK solo para el dueño. Los archivos públicos se sirven con su
      // enlace de descarga (token), que no pasa por estas reglas.
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.size > 0 && validUpload();
      allow delete: if owner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
