# Copia a .env y rellena. NUNCA subas .env a un repositorio público.
TURNSTILE_SECRET=         # Clave secreta de Cloudflare Turnstile (vacía = modo desarrollo, sin verificación real)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
STAGE_SECONDS=15          # Segundos por etapa (validados en el servidor)
APP_DOWNLOAD_URL=         # URL OFICIAL de la app (Play Store, etc.)
PORT=3000
